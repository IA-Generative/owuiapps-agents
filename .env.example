# MirAI Agent Builder — exemple de configuration
#
# Deux modes :
#   (1) Dépôt monté à côté de owuicore-main : ne rien saisir ici, le script
#       deploy/prepare-env.sh charge automatiquement ../owuicore-main/.env en
#       premier (credentials Scaleway + Postgres + Keycloak partagés), puis
#       superpose les valeurs de ce fichier.
#   (2) Déploiement isolé : remplir toutes les variables ci-dessous.
#
# Les variables déjà définies dans l'environnement shell l'emportent toujours
# (cf. load_dotenv_preserve_existing du socle).

# =============================================================================
# Variables spécifiques à l'Agent Builder (obligatoires)
# =============================================================================

# --- Image et tag ---
AGENT_BUILDER_IMAGE=rg.fr-par.scw.cloud/miraiku/miraiku-agents:dev

# --- Ingress / TLS ---
AGENTS_HOST=myagents.fake-domain.name
AGENTS_TLS_SECRET_NAME=agent-builder-tls

# --- NextAuth ---
# URL publique de l'app (prod K8s). En local, override à http://localhost:3001.
NEXTAUTH_URL=https://myagents.fake-domain.name
# openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME

# --- Base de données dédiée ---
# L'utilisateur "app" et le mot de passe "app" sont créés par
# owuicore-main/postgres/init/01-create-databases.sql. La base `agentbuilder`
# doit être créée manuellement (cf. README).
DATABASE_URL=postgresql://app:app@postgres:5432/agentbuilder?schema=public

# =============================================================================
# Variables héritées de owuicore-main/.env (ne remplir qu'en déploiement isolé)
# =============================================================================

# --- Namespace et registry Scaleway ---
# NAMESPACE=miraiku
# REGISTRY=rg.fr-par.scw.cloud/miraiku
# REGISTRY_SERVER=rg.fr-par.scw.cloud
# REGISTRY_USERNAME=nologin
# REGISTRY_PASSWORD=CHANGE_ME
# REGISTRY_EMAIL=ops@fake-domain.name
# IMAGE_TAG=0.1.0

# --- Keycloak / OIDC (socle) ---
# KEYCLOAK_ISSUER=https://mysso.fake-domain.name/realms/openwebui
# KEYCLOAK_CLIENT_ID=miraiku-agents
# KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# --- OpenWebUI (upstream BFF) ---
# OWUI_BASE_URL=http://openwebui:80

# --- Cert-manager ---
# LETSENCRYPT_EMAIL=ops@fake-domain.name
